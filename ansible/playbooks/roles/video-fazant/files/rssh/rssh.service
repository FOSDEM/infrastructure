[Unit]
Description=Reverse SSH Service
ConditionPathExists=|/usr/bin
After=network.target

[Service]
EnvironmentFile=/etc/rssh.config
ExecStart=/usr/bin/ssh -2NTC -R ${REVERSE_PORT}:127.0.0.1:${LOCAL_SSH_PORT} -i ${SSH_KEY} -o ServerAliveInterval=60 -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=no -o ControlMaster=no -p ${REMOTE_PORT} ${REMOTE_USER}@${REMOTE_HOST}
RestartSec=10
Restart=always

[Install]
WantedBy=multi-user.target

